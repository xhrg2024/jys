# ============================================
# 辑佚史智能体 — 环境变量配置模板
# ============================================
# 复制此文件为 .env 并修改其中的值：
#   cp .env.example .env
# ============================================

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=leishu_yongle

# FastAPI 服务端口（后端）
API_PORT=8000

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=jys123456

# 前端开发服务器端口
FRONTEND_PORT=15173

# ========== 外部 API 配置 ==========
# USE_API=true: 使用外部API
# USE_API=false: 使用本地Qwen模型
USE_API=true

# 通用API配置（兼容OpenAI格式的API均可使用）
# 切换厂商只需修改这3个变量即可
# 示例：
#   DeepSeek:  API_KEY=sk-xxx  BASE_URL=https://api.deepseek.com  API_MODEL=deepseek-chat
#   OpenAI:    API_KEY=sk-xxx  BASE_URL=https://api.openai.com/v1  API_MODEL=gpt-4o
#   智谱AI:    API_KEY=xxx     BASE_URL=https://open.bigmodel.cn/api/paas/v4  API_MODEL=glm-4
#   Moonshot:  API_KEY=xxx     BASE_URL=https://api.moonshot.cn/v1  API_MODEL=moonshot-v1-8k
#   Mimo:      API_KEY=xxx     BASE_URL=https://api.mimo.com/v1  API_MODEL=mimo-chat
API_KEY=your_api_key_here
BASE_URL=https://api.deepseek.com
API_MODEL=deepseek-chat