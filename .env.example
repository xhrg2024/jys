# ============================================
# 辑佚史智能体 — 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ============================================

# ---------- MySQL 数据库（本地开发） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=leishu_yongle

# ---------- FastAPI 服务（后端） ----------
API_PORT=8000
# 监听地址：默认 127.0.0.1（仅本机）；需要局域网访问时改为 0.0.0.0
API_HOST=127.0.0.1

# Bearer Token 鉴权（可选）：设置后所有接口（除 /health、/docs、静态资源）需带 Authorization: Bearer <token>
# 不设置则普通接口开放、但 /eval/* 会禁用（评测页不可用）
# 注意：改这个值后前端需重启（npm run dev）或重建（npm run build）才会把 token 烘焙进去
API_TOKEN=
# 跨域白名单（逗号分隔）。生产由后端托管前端、同源无需跨域，默认留空即可
CORS_ORIGINS=

# ---------- Neo4j 图数据库（注意：本地默认端口是 7687） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ---------- 前端开发服务器 ----------
FRONTEND_PORT=15173

# ========== 推理策略 ==========
# USE_API=true 用外部 API；false 用本地 Qwen 模型
USE_API=true
# 两段式 CoT 推理：先分析参考信息并逐字抄录实体名，再正式回答（减少幻觉）。
# 设为 false 关闭，恢复单轮直答（更快但出错率更高）
TWO_PASS=true

# ========== 外部 API（多模型） ==========
# 每个厂商一组 {前缀}_API_KEY / {前缀}_BASE_URL。
# 填了 API_KEY 即启用该厂商（前端下拉可选）；留空则前端置灰。
# BASE_URL 不填则用下方默认值；切换/更换中转站只需改对应厂商的 BASE_URL。

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 智谱 GLM (BigModel) ---
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Kimi (月之暗面) ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# --- 小米 MiMo ---
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# --- 通义千问 (DashScope) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 百度千帆 (文心一言) ---
QIANFAN_API_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# --- SurplusToken GPT ---
ST_GPT_API_KEY=
ST_GPT_BASE_URL=https://surplustoken.com/v1

# --- SurplusToken Gemini ---
ST_GEMINI_API_KEY=
ST_GEMINI_BASE_URL=https://surplustoken.com/v1

# --- 科大讯飞星火（Key 格式：AK:SK，用冒号拼接） ---
SPARK_API_KEY=
